# ============================================================
# X-VOCA Backend Environment Configuration Template
# ============================================================
# Salin file ini menjadi .env dan sesuaikan nilai variabel di bawah.
# JANGAN pernah melakukan commit kredensial asli ke version control (Git).

# Server Environment
PORT=3001
NODE_ENV=development

# Database MySQL (Sequelize ORM)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=password_database_anda
DB_NAME=xvoca_db
DB_SSL=false

# Autentikasi JWT (JSON Web Token)
JWT_SECRET=rahasia_jwt_minimal_32_karakter_acak

# Konfigurasi CORS (Domain Frontend yang Diizinkan)
# Di development, localhost:5173 otomatis diizinkan.
CORS_ORIGIN=http://localhost:5173

# Firebase Admin SDK & Realtime Database (RTDB)
# Digunakan untuk sinkronisasi live voting, status streaming, dan notifikasi
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
FIREBASE_SERVICE_ACCOUNT=./config/firebase-service-account.json
# Alternatif untuk platform cloud (Railway/Render): string base64 dari JSON service account
# FIREBASE_SERVICE_ACCOUNT_BASE64=
# FIREBASE_RTDB_SERVICE_ACCOUNT=
# FIREBASE_RTDB_SERVICE_ACCOUNT_BASE64=

# YouTube Data API v3 (Integrasi Live Streaming & Statistik Saluran)
YOUTUBE_API_KEY=your_youtube_api_key_here
YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxx
